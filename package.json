{
  "name": "tripmap-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "vitest run && npm test -w @tripmap/web",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "tsc -b && tsc -p packages/cli --noEmit && npm run typecheck -w @tripmap/web"
  },
  "engines": {
    "node": ">=22.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}
